Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "The", " ", "optimal", " ", "input", " ", "distribution", " ", "of", " ", 
   "ACh", " ", "comes", " ", "from", " ", "the", " ", "binomial", " ", 
   "distribution", " ", "which", " ", "limits", " ", "to", " ", "a", " ", 
   "Gaussian", " ", "distribution", " ", "in", " ", "the", " ", "large", " ", 
   "N", " ", "limit"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.989931877424827*^9, 
  3.9899319208492107`*^9}},ExpressionUUID->"33b8dfc7-2bb7-4237-9e84-\
56c0ab86d774"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ZAdultACh", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"p", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"popenAdultnAChR", "[", "0", "]"}], ",", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"popenAdultnAChR", "[", "c", "]"}], ",", 
        RowBox[{"c", "->", "Infinity"}]}], "]"}]}], "}"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.989932007700624*^9, 3.9899320386268187`*^9}, {
  3.989932583414505*^9, 3.9899325923925943`*^9}, {3.9899326593988123`*^9, 
