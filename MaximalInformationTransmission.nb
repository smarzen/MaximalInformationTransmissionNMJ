Cell[BoxData[
 RowBox[{
  RowBox[{"popenHill", "[", 
   RowBox[{"c_", ",", "Kd_", ",", "nH_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"c", "^", "nH"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"c", "^", "nH"}], "+", 
     RowBox[{"Kd", "^", "nH"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.98993176890742*^9, 3.989931783046817*^9}, {
  3.9900160442072287`*^9, 3.990016046828014*^9}, {3.990016098951077*^9, 
