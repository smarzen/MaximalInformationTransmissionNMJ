Cell[BoxData[
 RowBox[{
  RowBox[{"poptimalAdultACh2", "[", "c_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"popenAdultnAChR2", "[", "x", "]"}], ",", "x"}], "]"}], "/.", 
      
      RowBox[{"x", "->", "c"}]}], ")"}], "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"popenAdultnAChR2", "[", "c", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"popenAdultnAChR2", "[", "c", "]"}]}], ")"}]}], "]"}]}], "/", 
   "ZAdultACh2"}]}]], "Input",
