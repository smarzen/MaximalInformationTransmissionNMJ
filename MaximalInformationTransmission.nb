Cell[BoxData[
 RowBox[{"ZAdultACh2", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"p", "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", "p"}], ")"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"p", ",", 
      RowBox[{"popenAdultnAChR2", "[", "0", "]"}], ",", 
      RowBox[{"Limit", "[", 
       RowBox[{
        RowBox[{"popenAdultnAChR2", "[", "c", "]"}], ",", 
        RowBox[{"c", "->", "Infinity"}]}], "]"}]}], "}"}]}], "]"}]}]], "Input",\

