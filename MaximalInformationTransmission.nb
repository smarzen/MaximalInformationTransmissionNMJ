Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
   "This", " ", "code", " ", "is", " ", "structured", " ", "so", " ", "that", 
    " ", "we", " ", "first", " ", "get", " ", "theoretical", " ", "optimal", 
    " ", "input", " ", "distributions", " ", "for", " ", "concentrations", 
    " ", "of", " ", "ACh", " ", "and", " ", "glutamate"}], ",", " ", 
   RowBox[{"and", " ", "then", " ", "compare", " ", "them", " ", "to", " ", 
    RowBox[{"experiment", "."}]}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.9899284769699173`*^9, 
