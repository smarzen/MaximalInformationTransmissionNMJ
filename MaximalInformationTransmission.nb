Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Cholinergic", " ", 
    RowBox[{"NMJs", ":", " ", 
     RowBox[{
     "Optimal", " ", "input", " ", "distribution", " ", "for", " ", 
      "ACh"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Adult", " ", "nACh", " ", "receptors", " ", "have", " ", "a", " ", 
     "Hill", " ", "probability", " ", "of", " ", "being", " ", "open", " ", 
     "given", " ", "in", " ", "Prince", " ", "and", " ", "Sine"}], ",", " ", 
    RowBox[{
    "Journal", " ", "of", " ", "Biological", " ", "Chemistry", " ", "1999.", 
     " ", "There", " ", "were", " ", "parameters", " ", "given", " ", "for", 
     " ", "an", " ", "MWC", " ", "model"}], ",", " ", 
    RowBox[{
    "but", " ", "the", " ", "resulting", " ", "popen", " ", "curve", " ", 
     "did", " ", "not"}], ",", " ", 
    RowBox[{"upon", " ", "inspection", " ", "by", " ", "eye"}], ",", " ", 
    RowBox[{"match", " ", "the", " ", 
     RowBox[{"data", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"popenAdultnAChR", "[", "c_", "]"}], ":=", 
   RowBox[{"popenHill", "[", 
    RowBox[{"c", ",", 
     RowBox[{"1.5", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "6"}]}]}], ",", "1.3"}], "]"}]}]}]], "Input",
