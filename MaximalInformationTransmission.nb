    "binding", " ", "site", " ", "statistical", " ", "mechanical", " ", 
     "model"}]}], ",", " ", 
   RowBox[{
   "we", " ", "have", " ", "the", " ", "probability", " ", "of", " ", "open", 
    " ", "being"}]}], " ", "*)"}]], "Input",
