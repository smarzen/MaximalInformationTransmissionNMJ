5da9f7ab0198"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"From", " ", "a", " ", "two"}], "-", "state"}], ",", " ", 
   RowBox[{"two", "-", 
    RowBox[{
    "binding", " ", "site", " ", "statistical", " ", "mechanical", " ", 
     "model"}]}], ",", " ", 
   RowBox[{
   "we", " ", "have", " ", "the", " ", "probability", " ", "of", " ", "open", 
    " ", "being"}]}], " ", "*)"}]], "Input",
